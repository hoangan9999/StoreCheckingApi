<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Swagger reads the endpoint summaries from this file; see IncludeXmlComments in Program.cs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591 = "missing XML comment on a public member". The doc file exists for Swagger,
         not to force a comment onto every DTO property. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreChecking.Application\StoreChecking.Application.csproj" />
    <ProjectReference Include="..\StoreChecking.Infrastructure\StoreChecking.Infrastructure.csproj" />
  </ItemGroup>

</Project>
