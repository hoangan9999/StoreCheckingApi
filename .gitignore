# .NET
bin/
obj/
*.user

# Secrets and data — NEVER commit
.env

# Watchtower's GHCR credentials. config.json holds a real token — never commit it.
# Ship the folder and the example only.
watchtower/*
!watchtower/.gitkeep
!watchtower/config.example.json

# IDE
.vs/
.idea/

# Dumps pulled out of Supabase — production data, never commit.
_migration/

# Bản kết xuất database — dữ liệu thật. Chỉ chặn ở gốc repo: db/*.sql là file
# schema và PHẢI được theo dõi.
/backup.sql
/*-backup.sql
/*.dump
