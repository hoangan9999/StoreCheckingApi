# .NET
bin/
obj/
*.user

# Secrets and data — NEVER commit
.env

# Keep the pgdata folder itself but never its contents: Synology's Container Manager
# refuses to auto-create bind mount folders, so an empty folder has to ship with the
# deploy package.
pgdata/*
!pgdata/.gitkeep

# Tailscale node identity — same reasoning: ship the folder, never its contents.
ts-state/*
!ts-state/.gitkeep

# IDE
.vs/
.idea/

# Dumps pulled out of Supabase — production data, never commit.
_migration/
