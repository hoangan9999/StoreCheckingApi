# Copy this file to .env and fill it in. NEVER commit .env.
DB_USER=storechecking
DB_PASSWORD=change-this-password
# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Origins allowed to call this API, comma separated.
CORS_ORIGINS=https://inventory-and-tracking-profit-sand.vercel.app,http://localhost:4287
# Tailscale auth key, from https://login.tailscale.com/admin/settings/keys
# Needed so the API gets a valid HTTPS certificate on the tailnet. Without it the browser
# blocks every call from the Vercel-hosted app as mixed content.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Set to false to stop the API applying db/*.sql at startup (see docker-compose.yml).
SCHEMA_AUTOMIGRATE=true

# Nơi gửi bản sao lưu database hằng ngày. Dùng lại endpoint upload của nas-uploader,
# nên token chính là UPLOAD_SECRET của service đó.
NAS_UPLOAD_URL=https://nas-uploader.<tailnet>.ts.net
NAS_UPLOAD_TOKEN=doi-thanh-UPLOAD_SECRET-cua-ban

# Nhìn ảnh nhận ra là xe gì rồi viết kịch bản cho video tự sinh (tab Tiện ích).
# Lấy đúng khoá đang dùng trên Vercel: Project Settings -> Environment Variables.
GEMINI_API_KEY=
