# Copy this file to .env and fill it in. NEVER commit .env.
DB_USER=storechecking
DB_PASSWORD=change-this-password
# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Origins allowed to call this API, comma separated.
CORS_ORIGINS=https://inventory-and-tracking-profit-sand.vercel.app,http://localhost:4287
# Tailscale auth key, from https://login.tailscale.com/admin/settings/keys
# Needed so the API gets a valid HTTPS certificate on the tailnet. Without it the browser
# blocks every call from the Vercel-hosted app as mixed content.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
